{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev_agent/v2/devfarm-commander-plan",
  "title": "dev_agent v2 development-only Commander plan",
  "type": "object",
  "required": ["schema_version", "run_id", "objective", "base_revision", "tasks", "dependencies", "ownership", "assignments", "results"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,100}$"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "base_revision": {"type": "string", "minLength": 1, "maxLength": 200},
    "status": {"enum": ["PLANNED", "READY", "DISPATCHED", "PROPOSED", "HOST_VERIFIED", "REJECTED", "BLOCKED", "INTEGRATED", "SUPERSEDED"]},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "owner", "status", "dependencies", "ownership", "max_attempts", "attempt_count", "assignment"],
        "properties": {
          "task_id": {"type": "string"},
          "owner": {"enum": ["codex", "worker"]},
          "status": {"$ref": "#/$defs/status"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "ownership": {"type": "array", "items": {"type": "string"}},
          "manifest_path": {"type": ["string", "null"]},
          "manifest_history": {"type": "array", "items": {"type": "string"}},
          "max_attempts": {"type": "integer", "minimum": 1},
          "attempt_count": {"type": "integer", "minimum": 0},
          "worker_candidate": {"type": "boolean"},
          "delegation_reason": {"type": "string", "maxLength": 1000},
          "last_attempt_id": {"type": "string"},
          "result_ref": {"type": "string"},
          "last_result_status": {"type": "string"},
          "last_error": {"type": "string"},
          "block_reason": {"type": "string"},
          "integration_note": {"type": "string"},
          "target_ref": {"type": "string"},
          "integration_revision": {"type": "string"},
          "source_attempt_id": {"type": "string"},
          "verified_patch_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "dispatch_id": {"type": "string"},
          "dispatch_started_at": {"type": "string"},
          "dispatch_deadline_at": {"type": "string"},
          "dispatch_owner_pid": {"type": "integer", "minimum": 1},
          "dispatch_recovery": {"type": "string"},
          "stale_result_attempt_id": {"type": "string"},
          "assignment": {"$ref": "#/$defs/assignment"}
        }
      }
    },
    "dependencies": {"type": "array", "items": {"type": "object", "required": ["task_id", "depends_on"], "properties": {"task_id": {"type": "string"}, "depends_on": {"type": "array", "items": {"type": "string"}}}}},
    "ownership": {"type": "array", "items": {"type": "object", "required": ["task_id", "paths"], "properties": {"task_id": {"type": "string"}, "paths": {"type": "array", "items": {"type": "string"}}}}},
    "assignments": {"type": "array", "items": {"$ref": "#/$defs/assignment"}},
    "results": {"type": "array", "items": {"type": "object", "required": ["task_id", "stage", "status"], "properties": {"task_id": {"type": "string"}, "stage": {"type": "string"}, "status": {"type": "string"}, "result_ref": {"type": "string"}, "attempt_id": {"type": "string"}, "recorded_at": {"type": "string"}}}},
    "review_decisions": {"type": "array", "items": {"$ref": "#/$defs/review_decision"}},
    "supervisor": {"$ref": "#/$defs/supervisor"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "$defs": {
    "status": {"enum": ["PLANNED", "READY", "DISPATCHED", "PROPOSED", "HOST_VERIFIED", "REJECTED", "BLOCKED", "INTEGRATED", "SUPERSEDED"]},
    "assignment": {
      "type": "object",
      "required": ["task_id", "owner"],
      "properties": {
        "task_id": {"type": "string"},
        "owner": {"enum": ["codex", "worker"]},
        "provider_id": {"type": "string"},
        "provider_binding_id": {"type": "string"},
        "model_id": {"type": "string"}
      }
    },
    "supervisor": {
      "type": "object",
      "required": ["schema_version", "status", "roadmap_reference", "cadence_minutes", "unchanged_check_limit", "unchanged_check_count", "next_action", "wake_events", "metrics"],
      "properties": {
        "schema_version": {"const": 1},
        "status": {"enum": ["ACTIVE", "WAITING_FOR_WORKER", "WORKER_RESULT_READY", "REVIEWING", "INTEGRATING", "HUMAN_DECISION_REQUIRED", "COMPLETED", "BLOCKED"]},
        "roadmap_reference": {"type": "object"},
        "roadmap_position": {"type": ["string", "null"]},
        "cadence_minutes": {"enum": [1, 5, 10, 15]},
        "unchanged_check_limit": {"type": "integer", "minimum": 1, "maximum": 3},
        "unchanged_check_count": {"type": "integer", "minimum": 0},
        "overall_deadline": {"type": ["string", "null"]},
        "next_action": {"type": "string"},
        "wake_events": {"type": "array", "maxItems": 64, "items": {"type": "object"}},
        "review_packets": {"type": "array", "maxItems": 64, "items": {"type": "object"}},
        "metrics": {"type": "object"}
      }
    },
    "review_decision": {
      "type": "object",
      "required": ["decision_id", "task_id", "attempt_id", "decision", "findings", "evidence_refs"],
      "properties": {
        "decision_id": {"type": "string"},
        "task_id": {"type": "string"},
        "attempt_id": {"type": "string"},
        "decision": {"enum": ["APPROVE_INTEGRATION", "REWORK", "REJECT", "ESCALATE"]},
        "findings": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "object"}},
        "required_correction": {"type": "string"},
        "reviewer_role": {"type": "string"},
        "decided_at": {"type": "string"}
      }
    }
  }
}
